# Local, personal Claude Code settings
.claude/settings.local.json

# OS / editor noise
.DS_Store

# Build artifacts
/glassfrog
# Plain `go build` dev binary (named after the repo when built with no -o)
/cli-glassfrog
# GoReleaser output (snapshot/matrix binaries + the artifacts.json manifest).
# This also covers the npm channel's generated packages (spec 037): the
# release-time generator (npm/build.mjs) emits the umbrella + four platform
# package directories into dist/npm/, which are published, never committed.
/dist/

# npm auth token for local publish/testing — a secret, never commit it.
# (Release publishing uses tokenless OIDC; no token is needed in CI.)
.npmrc
